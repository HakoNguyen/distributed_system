# =====================================================================
# NODE C khi chạy 3 node trên MỘT máy (make local-up). Không chép thành .env.
# POS CN3: http://localhost:8021   Dashboard bản sao C: http://localhost:8020
# =====================================================================

# Mọi node chạy một broker Redpanda (cụm 3 broker)
COMPOSE_PROFILES=broker

# ---- Địa chỉ các node: GIỐNG NHAU ở 3 file local-*.env ----
# Một máy: các node gặp nhau qua docker network minigo-wan, gọi nhau bằng alias riêng
# (replica-b, branch-b, redpanda-b), KHÔNG dùng tên service: trên minigo-wan tên service trỏ về cả 3 node.
# Cụm 3 broker: GIỐNG NHAU ở 3 file. RPC giữa broker :33145, client :19092 (cùng host, cùng thứ tự)
BROKER_SEEDS=redpanda-a:33145,redpanda-b:33145,redpanda-c:33145
KAFKA_BROKERS=redpanda-a:19092,redpanda-b:19092,redpanda-c:19092
REPLICA_A=replica-a:8000
REPLICA_B=replica-b:8000
REPLICA_C=replica-c:8000
BRANCH_A=branch-a:8000
BRANCH_B=branch-b:8000
BRANCH_C=branch-c:8000
REPLICA_URLS=A=http://replica-a:8000,B=http://replica-b:8000,C=http://replica-c:8000

# ---- Node này ----
NODE_NAME=C
BRANCH_ID=3
BRANCH_NAME=Đà Nẵng
# Cổng host, không trùng giữa 3 node
# Địa chỉ POS của node này cho bản sao các node khác gọi khi đối soát (gửi kèm heartbeat)
BRANCH_URL=http://branch-c:8000
BRANCH_PORT=8021
REPLICA_PORT=8020
# Broker của node này tự giới thiệu địa chỉ này cho client và broker khác
BROKER_HOST=redpanda-c

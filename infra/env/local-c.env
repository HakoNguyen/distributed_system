# =====================================================================
# NODE C khi chạy 3 node trên MỘT máy (make local-up). Không chép thành .env.
# POS CN3: http://localhost:8021   Dashboard bản sao C: http://localhost:8020
# =====================================================================

# ---- Địa chỉ các node: GIỐNG NHAU ở 3 file local-*.env ----
# Một máy: các node gặp nhau qua docker network minigo-wan, gọi nhau bằng alias riêng
# (replica-b, branch-b, redpanda-a), KHÔNG dùng tên service: trên minigo-wan tên service trỏ về cả 3 node.
IP_A=redpanda-a
REPLICA_A=replica-a:8000
REPLICA_B=replica-b:8000
REPLICA_C=replica-c:8000
BRANCH_A=branch-a:8000
BRANCH_B=branch-b:8000
BRANCH_C=branch-c:8000
REPLICA_URLS=A=http://replica-a:8000,B=http://replica-b:8000,C=http://replica-c:8000

# ---- Node này ----
NODE_NAME=C
BRANCH_ID=3
BRANCH_NAME=Đà Nẵng
# Cổng host, không trùng giữa 3 node
BRANCH_PORT=8021
REPLICA_PORT=8020
KAFKA_BROKERS=redpanda-a:19092

# =====================================================================
# MÁY B: chi nhánh 2 + bản sao B
# Dùng: copy file này thành .env ở gốc repo.
#   Windows:     copy infra\env\may-b.env .env
#   macOS/Linux: cp infra/env/may-b.env .env
# =====================================================================

# Để gõ `docker compose ...` ngắn gọn từ gốc repo, không cần thêm -f
COMPOSE_FILE=infra/compose.yml

# ---- IP overlay của các máy: GIỐNG NHAU ở mọi file env ----
IP_A=100.64.0.1
IP_B=100.64.0.2
# IP_C=100.64.0.3

# ---- Máy này ----
NODE_NAME=B
BRANCH_ID=2
BRANCH_NAME=Hà Đông

# Redpanda ở máy A, đi qua cửa ngoài 19092 và mạng overlay
KAFKA_BROKERS=100.64.0.1:19092

# Có máy C thì thêm ,C=http://<IP_C>:8000
REPLICA_URLS=A=http://100.64.0.1:8000,B=http://replica_api:8000

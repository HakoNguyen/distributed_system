# =====================================================================
# MÁY B: broker 2 + chi nhánh 2 + bản sao B
# Dùng: copy file này thành .env ở gốc repo.
#   Windows:     copy infra\env\may-b.env .env
#   macOS/Linux: cp infra/env/may-b.env .env
# =====================================================================

# Để gõ `docker compose ...` ngắn gọn từ gốc repo, không cần thêm -f
COMPOSE_FILE=infra/compose.yml

# Mọi máy chạy một broker Redpanda (cụm 3 broker)
COMPOSE_PROFILES=broker

# ---- Địa chỉ các máy: GIỐNG NHAU ở file env của mọi máy ----
# Thay 100.64.0.x bằng IP overlay thật (Tailscale 100.x.x.x hoặc ZeroTier); đổi thì sửa ở mọi file.
# Cụm 3 broker, mỗi máy một broker: RPC giữa broker :33145, client :19092 (cùng host, cùng thứ tự).
# Chỉ có 2 máy thật: xem docs/demo.md mục 2 (bỏ máy C và broker máy B).
BROKER_SEEDS=100.64.0.1:33145,100.64.0.2:33145,100.64.0.3:33145
KAFKA_BROKERS=100.64.0.1:19092,100.64.0.2:19092,100.64.0.3:19092
# Nginx (máy A) gọi bản sao (REPLICA_*) và POS (BRANCH_*) từng máy bằng host:port.
# Máy A cùng mạng Docker với nginx nên dùng tên service; máy khác dùng IP overlay + cổng host.
REPLICA_A=replica_api:8000
REPLICA_B=100.64.0.2:8000
REPLICA_C=100.64.0.3:8000
BRANCH_A=branch_api:8000
BRANCH_B=100.64.0.2:8001
BRANCH_C=100.64.0.3:8001

# ---- Máy này ----
NODE_NAME=B
BRANCH_ID=2
BRANCH_NAME=Hà Đông

# Broker máy này tự giới thiệu địa chỉ này (IP overlay của CHÍNH máy này) cho client và broker khác
BROKER_HOST=100.64.0.2

# Địa chỉ POS của CHÍNH máy này (IP overlay, cổng host 8001), gửi kèm heartbeat để bản sao mọi máy đối soát
BRANCH_URL=http://100.64.0.2:8001

REPLICA_URLS=A=http://100.64.0.1:8000,B=http://replica_api:8000,C=http://100.64.0.3:8000

# =====================================================================
# MÁY C (tuỳ chọn): chi nhánh 3 + bản sao C
# Nhớ: thêm máy C vào REPLICA_URLS của may-a.env, may-b.env, và bỏ dấu #
# ở các dòng [MÁY C] trong infra/nginx/default.conf.template.
# =====================================================================

# Để gõ `docker compose ...` ngắn gọn từ gốc repo, không cần thêm -f
COMPOSE_FILE=infra/compose.yml

IP_A=100.64.0.1
IP_B=100.64.0.2
IP_C=100.64.0.3

NODE_NAME=C
BRANCH_ID=3
BRANCH_NAME=Đà Nẵng

KAFKA_BROKERS=100.64.0.1:19092
REPLICA_URLS=A=http://100.64.0.1:8000,B=http://100.64.0.2:8000,C=http://replica_api:8000

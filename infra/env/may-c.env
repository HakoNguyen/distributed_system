# =====================================================================
# MÁY C: chi nhánh 3 + bản sao C
# Dùng: copy file này thành .env ở gốc repo.
#   Windows:     copy infra\env\may-c.env .env
#   macOS/Linux: cp infra/env/may-c.env .env
# =====================================================================

# Để gõ `docker compose ...` ngắn gọn từ gốc repo, không cần thêm -f
COMPOSE_FILE=infra/compose.yml

# ---- Địa chỉ các máy: GIỐNG NHAU ở file env của mọi máy ----
# Thay 100.64.0.x bằng IP overlay thật (Tailscale 100.x.x.x hoặc ZeroTier); đổi thì sửa ở mọi file.
# IP_A: Redpanda máy A tự giới thiệu địa chỉ này cho máy khác.
IP_A=100.64.0.1
# Nginx (máy A) gọi bản sao (REPLICA_*) và POS (BRANCH_*) từng máy bằng host:port.
# Máy A cùng mạng Docker với nginx nên dùng tên service; máy khác dùng IP overlay + cổng host.
REPLICA_A=replica_api:8000
REPLICA_B=100.64.0.2:8000
REPLICA_C=100.64.0.3:8000
BRANCH_A=branch_api:8000
BRANCH_B=100.64.0.2:8001
BRANCH_C=100.64.0.3:8001

# ---- Máy này ----
NODE_NAME=C
BRANCH_ID=3
BRANCH_NAME=Đà Nẵng

# Redpanda ở máy A, đi qua cửa ngoài 19092 và mạng overlay
KAFKA_BROKERS=100.64.0.1:19092

REPLICA_URLS=A=http://100.64.0.1:8000,B=http://100.64.0.2:8000,C=http://replica_api:8000

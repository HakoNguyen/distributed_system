# =====================================================================
# Nginx: CỔNG VÀO, chạy ở MỌI máy (vòng 5), cấu hình giống hệt nhau: vào cổng nào cũng tới được
# mọi bản sao và mọi chi nhánh (tính trong suốt vị trí). Một cổng chết thì dashboard, POS đang mở
# tự chuyển sang cổng khác trong GATEWAYS (failover phía client, như bootstrap.servers của Kafka).
#
# ${REPLICA_A}... ${BRANCH_C} là địa chỉ host:port, thay bằng giá trị trong .env
# lúc container khởi động:
#   máy thật:  REPLICA_B=100.64.0.2:8000   BRANCH_B=100.64.0.2:8001 (cổng host)
#   một máy:   REPLICA_B=replica-b:8000    BRANCH_B=branch-b:8000   (cổng trong container)
# Tên được phân giải ĐỘNG (`resolve`, DNS của Docker 127.0.0.11, cần nginx >= 1.27.3): nginx khởi
# động được cả khi node khác chưa chạy hoặc đang bị rút mạng; tên chưa có thì đường đó trả 502.
# Chỉ có 2 máy thật: chạy được, nhưng bản sao C hiện "Không liên lạc được" và thỉnh thoảng một
# request chậm khoảng 1 giây (mỗi worker nginx tự thử lại C sau 10 giây).
# Muốn gọn: thêm # trước dòng "server ${REPLICA_C}" và bỏ "C" ở /lb/replicas.json.
# =====================================================================

# DNS nội bộ của Docker; hỏi lại tên mỗi 5 giây (IP đổi sau make heal hay build lại vẫn đúng)
resolver 127.0.0.11 valid=5s ipv6=off;

# Nhóm các bản sao trung tâm. Mặc định nginx chia lần lượt (round-robin).
# zone: bộ nhớ chung giữa các worker, bắt buộc khi dùng `resolve`.
upstream replicas {
    zone replicas 64k;
    # max_fails=1 fail_timeout=10s: gọi một bản sao thất bại 1 lần thì
    # tạm gạch tên nó 10 giây, sau đó thử lại xem nó sống lại chưa.
    server ${REPLICA_A}  resolve max_fails=1 fail_timeout=10s;   # máy A
    server ${REPLICA_B}  resolve max_fails=1 fail_timeout=10s;   # máy B (qua mạng overlay)
    server ${REPLICA_C}  resolve max_fails=1 fail_timeout=10s;   # [MÁY C]
}

# Từng bản sao, từng chi nhánh riêng (đi thẳng, không chia tải)
upstream replica_a { zone replica_a 64k; server ${REPLICA_A} resolve; }
upstream replica_b { zone replica_b 64k; server ${REPLICA_B} resolve; }
upstream replica_c { zone replica_c 64k; server ${REPLICA_C} resolve; }
upstream branch_a  { zone branch_a  64k; server ${BRANCH_A}  resolve; }
upstream branch_b  { zone branch_b  64k; server ${BRANCH_B}  resolve; }
upstream branch_c  { zone branch_c  64k; server ${BRANCH_C}  resolve; }

server {
    listen 80;
    charset utf-8;

    # Máy mất mạng thì gói tin rơi mất, không ai trả lời "từ chối".
    # Chỉ chờ kết nối 1 giây rồi bỏ cuộc, chuyển sang bản sao khác.
    proxy_connect_timeout 1s;
    proxy_read_timeout    5s;
    proxy_set_header Host $host;

    # Ghi vào mọi phản hồi địa chỉ bản sao đã trả lời, để kiểm tra bằng curl -I
    add_header X-Upstream $upstream_addr always;

    # CORS (vòng 5): trang mở từ cổng này gọi được cổng khác khi chuyển cổng. Không có cookie hay
    # xác thực nên cho mọi origin; production thì liệt kê đúng các origin (docs/spec.md mục 6).
    # Không location nào được tự đặt add_header, nếu không các dòng này bị bỏ ở location đó.
    add_header Access-Control-Allow-Origin  * always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    # POS gửi JSON nên trình duyệt hỏi trước bằng OPTIONS
    if ($request_method = OPTIONS) { return 204; }

    # ---------------- Dashboard: chia tải + tự chuyển khi lỗi ----------------
    location / {
        proxy_pass http://replicas;
        # Bản sao được chọn không trả lời được -> thử ngay bản sao kế tiếp.
        # Nginx chỉ tự thử lại với yêu cầu idempotent (GET...). POST không được
        # thử lại, vì gửi hai lần có thể thành hai lượt bán (mục 2.3.1 Chương 2).
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }

    # ---------------- Danh sách cho trình duyệt ----------------
    location = /lb/replicas.json {
        default_type application/json;
        return 200 '["A","B","C"]';
    }
    # Mọi cổng vào (GATEWAYS, giống nhau ở mọi máy): trang đọc một lần lúc mở, để biết chuyển sang đâu
    location = /lb/gateways.json {
        default_type application/json;
        return 200 '"${GATEWAYS}"';
    }

    # ---------------- Đi thẳng tới từng bản sao, để so sánh chúng ----------------
    location /replica/A/ { proxy_pass http://replica_a/; }
    location /replica/B/ { proxy_pass http://replica_b/; }
    location /replica/C/ { proxy_pass http://replica_c/; }

    # ---------------- Màn hình quầy của từng chi nhánh ----------------
    # Quản lý ở trụ sở mở http://<IP máy bất kỳ>/cn2/ mà không cần biết CN2 ở máy nào.
    # Dữ liệu của một chi nhánh chỉ nằm ở chi nhánh đó, nên không có bản sao
    # dự phòng: máy chi nhánh mất mạng thì trang này báo rõ thay vì treo.
    location /cn1/ { proxy_pass http://branch_a/; error_page 502 504 = @branch_offline; }
    location /cn2/ { proxy_pass http://branch_b/; error_page 502 504 = @branch_offline; }
    location /cn3/ { proxy_pass http://branch_c/; error_page 502 504 = @branch_offline; }

    location @branch_offline {
        default_type "text/html; charset=utf-8";
        return 503 '<!doctype html><meta charset="utf-8"><title>Chi nhánh mất liên lạc</title>
<body style="font-family:system-ui,sans-serif;max-width:40rem;margin:4rem auto;line-height:1.5">
<h1 style="color:#C8312A">Không liên lạc được với chi nhánh này</h1>
<p>Máy của chi nhánh đang mất mạng tới trụ sở. Tại quầy vẫn bán bình thường trên chính máy đó
(http://localhost:8001). Số liệu sẽ tự đồng bộ lên trụ sở khi có mạng lại.</p>
<p><a href="/">Về dashboard toàn chuỗi</a></p></body>';
    }
}
